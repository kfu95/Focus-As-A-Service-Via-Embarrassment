{
  "manifest_version": 3,
  "name": "Jail",
  "version": "1.0.0",
  "description": "Browsing lockdown until your Mac helper sends a Messages group alert.",
  "incognito": "spanning",
  "permissions": ["tabs", "alarms", "storage", "nativeMessaging"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html",
  "action": {
    "default_title": "Jail settings"
  }
}
